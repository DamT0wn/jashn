# Copy to .env at repository root; defaults run locally without this file.
PORT=3001
HOST=127.0.0.1
API_PROXY_TARGET=http://127.0.0.1:3001
# Public browser configuration. Local /api uses Vite's proxy.
VITE_API_BASE_URL=/api
# Future Phase 05 Firebase PUBLIC web-app config (not credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Future server-only configuration; unused until the relevant integration phase.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
GENERATION_ENABLED=false
GENERATION_DAILY_LIMIT=0
# Optional emulator hosts, set only for local emulator testing in Phase 05.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Use ADC/service identity; never put private keys or tokens in VITE_* variables.
