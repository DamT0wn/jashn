# Copy to .env at repository root; defaults run locally without this file.
PORT=3001
HOST=127.0.0.1
API_PROXY_TARGET=http://127.0.0.1:3001
# Public browser configuration. Local /api uses Vite's proxy.
VITE_API_BASE_URL=/api
# Firebase PUBLIC web-app config (not credentials). Enable Auth providers in Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server Firebase project; use ADC/service identity. Set NODE_ENV=production when deployed.
GOOGLE_CLOUD_PROJECT=
# Server-only Vertex AI configuration. See docs/AI.md before enabling.
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
GENERATION_ENABLED=false
GENERATION_DAILY_LIMIT=10
GENERATION_GLOBAL_DAILY_LIMIT=30
GENERATION_CONCURRENCY=2
# For local emulators use .env.emulator.example instead; never combine live and emulator config.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Use ADC/service identity; never put private keys or tokens in VITE_* variables.

# Never enable on a live project. Local demo emulator configuration only.
MOCK_GENERATION_ENABLED=false
